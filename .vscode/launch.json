{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "python": "${command:python.interpreterPath}",
            "cwd": "${workspaceFolder}",
            "args": [
                "main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--log-level",
                "debug"
            ],
            "jinja": true,
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}